    <string name="ui_merge_import_057">&quot;Merge import&quot;</string>
    <string name="ui_select_a_file_or_paste_058">&quot;Select a file or paste encrypted text and enter the same key. Preview additions and skips before importing. Only records with every stored value identical are skipped; any difference creates another entry. Existing records remain intact. Groups with the same name are matched before comparison. Password and note case, whitespace, TOTP settings, recovery-code order, and used flags are all compared.&quot;</string>
